# Copy to .env (optional). Every value has a working default.
# Read by `npm start`, `npm run bootstrap`, `npm run smoke` and `npm run analytics:replay`.

# LocalStack gateway. Leave unset to discover it (docker ps, then http://localhost:4566).
# LOCALSTACK_ENDPOINT_URL=http://127.0.0.1:4566

# Region and resource namespace inside the shared LocalStack (lowercase, digits, hyphens).
AWS_REGION=us-east-1
DEMO_RESOURCE_PREFIX=ridedemo

# Backend ports. Leave unset to use the first free port from 4100 (Rides), 4101 (Marketplace), 4102 (Payments).
# RIDES_API_PORT=4100
# MARKETPLACE_API_PORT=4101
# PAYMENTS_API_PORT=4102

# Browser origin(s) of the Next.js app, comma-separated. Used for the Rides CORS allow-list.
FRONTEND_ORIGIN=http://localhost:3000
