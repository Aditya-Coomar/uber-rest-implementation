# Only needed when running this package on its own (npm start / npm run worker).
# The root `npm start` passes all of these automatically.
LOCALSTACK_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
DEMO_RESOURCE_PREFIX=ridedemo
PORT=4100
BIND_HOST=127.0.0.1
MARKETPLACE_API_BASE_URL=http://127.0.0.1:4101
PAYMENTS_API_BASE_URL=http://127.0.0.1:4102
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: skip the queue lookup in the worker
# TRIP_EVENTS_QUEUE_URL=
