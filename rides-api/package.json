{
  "name": "rides-api",
  "version": "1.0.0",
  "private": true,
  "description": "Rides: public REST API, ride lifecycle, fare quote, orchestration, analytics read model, and the durable worker.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "bootstrap": "node --env-file-if-exists=.env dist/scripts/bootstrap.js",
    "analytics:replay": "node --env-file-if-exists=.env dist/scripts/replay.js",
    "smoke": "node --env-file-if-exists=.env dist/scripts/smoke.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/client-sqs": "^3.1170.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
